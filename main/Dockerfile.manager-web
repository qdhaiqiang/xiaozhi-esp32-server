FROM node:22-bookworm AS web-build

WORKDIR /build/manager-web
COPY manager-web/package*.json ./
RUN npm install
COPY manager-web/ ./
RUN npm run build

FROM maven:3.9-eclipse-temurin-21 AS api-build

WORKDIR /build/manager-api
COPY manager-api/pom.xml ./
RUN mvn -q -DskipTests dependency:go-offline
COPY manager-api/ ./
COPY --from=web-build /build/manager-web/dist ./src/main/resources/static
RUN mvn -q -DskipTests package

FROM eclipse-temurin:21-jre

ENV TZ=Asia/Shanghai
WORKDIR /app
COPY --from=api-build /build/manager-api/target/xiaozhi-esp32-api.jar /app/app.jar
EXPOSE 8002
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
